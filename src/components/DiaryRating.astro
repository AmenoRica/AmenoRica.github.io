---
const { rating, id } = Astro.props;
const star = 'M12 2.5 14.9 8.4 21.4 9.3 16.7 13.9 17.8 20.4 12 17.3 6.2 20.4 7.3 13.9 2.6 9.3 9.1 8.4Z';
---
{rating !== undefined && <span class="entry-rating" id={id} role="img" aria-label={`5점 만점에 ${rating}점`}>
{Array.from({length:5}, (_, index) => <svg viewBox="0 0 24 24" aria-hidden="true"><path d={star} fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" /><path d={star} fill="currentColor" style={`clip-path:inset(0 ${100 - Math.max(0, Math.min(1, rating - index)) * 100}% 0 0)`} /></svg>)}
</span>}
