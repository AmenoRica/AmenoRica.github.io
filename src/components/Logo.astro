---
import AmenoRule from './AmenoRule.astro';
const { category } = Astro.props;
const { title, style, image } = category.data;
---
<span class:list={['post-logo', style]} aria-label={title}>
  {image ? <img src={image} alt="" style="max-width:130px;max-height:38px;vertical-align:middle" /> : category.id === 'amenofuri' ? <span aria-hidden="true">Ameno<span class="signature">Furi</span></span> : category.id === 'amenorica' ? <><AmenoRule /><span>AmenoRica</span></> : category.id === 'weblog' && title.startsWith('We') ? <><span class="weblog-initial">{title[0]}</span>{title.slice(1)}</> : title}
</span>

<style>
  .weblog-initial { margin-inline-end: -.05em; }
</style>
