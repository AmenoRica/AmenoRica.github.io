---
import { getCollection, getEntry, render } from 'astro:content';
import Logo from '../../components/Logo.astro';
import { displayDate, lastModified } from '../../lib/dates.mjs';
export async function getStaticPaths() {
  return (await getCollection('posts', ({data}) => !data.draft)).map(post => ({params: {slug:post.id}, props:{post}}));
}
const { post } = Astro.props;
const { Content } = await render(post);
const category = await getEntry(post.data.category);
const modified = lastModified(post.filePath, post.data.createdAt);
---
<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<script is:inline>document.documentElement.classList.add('font-loading');</script>
  <script is:inline src="/font-ready.js" onerror="document.documentElement.classList.remove('font-loading')" defer></script>
  <link rel="preload" href="/assets/fonts/pretendard/latin.woff2" as="font" type="font/woff2" crossorigin>
<title>{post.data.title.replace(/\s*[\r\n]+\s*/g, " ")} — AmenoRica</title>
<script is:inline src="../theme-preference.js"></script>
<link rel="stylesheet" href="../../assets/fonts.css?v=workshop-release">
<link rel="stylesheet" href="/blog/article.css"><link rel="stylesheet" href="/blog/logos.css?v=workshop-release">
<script is:inline type="module">import { createTheme } from "../theme-mode.mjs"; createTheme();</script>
<link rel="preload" href="/assets/fonts/ibm-plex-mono.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/blog/ameno-logo.css"><link rel="icon" type="image/svg+xml" href="/favicon.svg"></head>
<body id="top">
<a class="skip" href="#article">본문으로 건너뛰기</a>
<nav aria-label="주 메뉴"><div class="brand-group"><a data-fonts="400 30px &quot;Barlow Semi Condensed&quot;" class="brand" href="../" aria-label="AmenoRica"><svg class="ameno-rule" viewBox="0 0 17.5 100" preserveAspectRatio="none" aria-hidden="true"><rect x="0" y="20" width="1" height="60"/><rect x="5.5" y="0" width="1" height="100"/><rect x="11" y="40" width="1" height="60"/><rect x="16.5" y="60" width="1" height="40"/></svg><span>AmenoRica</span></a></div><a class="nav-label" href="../">← List</a></nav>
<main class="layout" data-fonts="400 30px &quot;Barlow Semi Condensed&quot;|400 30px &quot;Pretendard&quot;|400 30px &quot;Blog Bodoni&quot;|400 30px &quot;AmenoFuri Logo&quot;|400 30px &quot;ugcatalog Logo&quot;|400 30px &quot;Bukichi Logo&quot;|400 30px &quot;Super Beatpop&quot;">
<aside aria-label="글 정보"><Logo category={category} /><time datetime={post.data.createdAt} aria-label="첫 작성일">{displayDate(post.data.createdAt)}</time>{modified && <p class="modified"><time datetime={modified}>{displayDate(modified)}.에 마지막 수정</time></p>}</aside>
<article id="article" lang="ko">
<header class="article-head"><h1>{post.data.title.split(/\r\n?|\n/).map((line, index) => <>{index > 0 && <br />}{line}</>)}</h1>{post.data.subtitle && <p class="intro">{post.data.subtitle}</p>}</header>
<div class="body"><Content /></div>
<div class="end"><a href="../">← List</a><a href="#top">Top ↑</a></div>
</article>
</main>

<div id="theme-ink" aria-hidden="true" hidden></div>
<button class="theme-toggle" type="button" aria-label="라이트 모드" aria-pressed="false">◐</button>
</body></html>
